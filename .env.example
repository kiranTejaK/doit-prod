# ==============================================================================
# Environment Configuration Template
# Copy this file to `.env` and replace placeholders with secure production values.
# ==============================================================================

# Project Details
PROJECT_NAME="DOit"
ENVIRONMENT="local" # "local" | "staging" | "production"

# Security & Tokens
# Generate with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-with-a-very-long-secure-random-secret-key"

# Access & Refresh Token Lifecycles
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh Token Cookie Settings
REFRESH_TOKEN_COOKIE_NAME="refresh_token"
REFRESH_TOKEN_COOKIE_SECURE=false # Set to true in production (HTTPS)
REFRESH_TOKEN_COOKIE_SAMESITE="lax" # "lax" | "strict" | "none"

# Frontend & CORS Configuration
FRONTEND_HOST="http://localhost:5173"
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="doit"

# Redis Cache Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379

# First Superuser (Initial Admin Seed)
FIRST_SUPERUSER="admin@doit.com"
FIRST_SUPERUSER_PASSWORD="ChangeThisPassword123!"

# Email & SMTP Settings
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL="info@doit.com"
EMAILS_FROM_NAME="DOit Platform"

# Observability & Sentry (Optional)
SENTRY_DSN=""
